# Server Configuration
SERVER_PORT=8080

# File Upload Settings
MAX_FILE_SIZE=10485760

# Image dimension limits (pixels)
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096

# Mosaic parameter bounds (must match frontend)
MIN_TILE_SIZE=5
MAX_TILE_SIZE=100

# Abuse prevention
MAX_CONCURRENT_GENERATIONS=2
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=3600
REQUEST_TIMEOUT=120

# Set true when exposed on the public internet (hides internal error details)
PRODUCTION=false

# Tiles Configuration
TILES_DIR=tiles

# Logging
LOG_LEVEL=info

# Development Settings (optional)
# DEBUG=true
# CORS_ORIGIN=*
